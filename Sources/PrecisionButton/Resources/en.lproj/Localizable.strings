/* Pointer tab */
"ポインタの加速" = "Pointer acceleration";
"ポインタの速度" = "Pointer speed";
"システムデフォルトに戻す" = "Restore System Defaults";
"トラックボールでカーソルを動かすときの感触です。システム全体のポインタ加速（システム設定の「軌跡の速さ」と同じ値）を変更します。" = "How the cursor feels when you roll the ball. This changes the system pointer acceleration — the same value as “Tracking speed” in System Settings.";
"macOSの標準は 3 です。0 で加速なし＝等速になります。" = "macOS defaults to 3. Set 0 for linear tracking with no acceleration.";
"標準は 0.069（400 DPI 相当）です。値を上げるほど速く、下げるほど遅くなります。" = "The default is 0.069 (equivalent to 400 DPI). Higher is faster, lower is slower.";
"デバイスの現在値: %.0f DPI / 加速 %.2f" = "Device reports: %.0f DPI / acceleration %.2f";
"デバイスの現在値を取得できません" = "Cannot read the device values";
"ポインタ設定の対象デバイスが見つかりません" = "No pointing device found for these settings";
"ポインタ設定を適用できません（この macOS では非対応）" = "Cannot apply pointer settings (unsupported on this macOS)";
"ポインタ設定をシステムデフォルトに戻しました" = "Pointer settings restored to system defaults";

/* Scroll tab */
